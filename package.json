{
   "name": "motionz",
   "version": "0.0.1",
   "description": "A lightweight motion helper for DOM entry animations.",
   "main": "./dist/motionz.umd.js",
   "module": "./dist/motionz.es.js",
   "types": "./dist/index.d.ts",
   "unpkg": "./dist/motionz.umd.js",
   "jsdelivr": "./dist/motionz.umd.js",
   "exports": {
      ".": {
         "import": "./dist/motionz.es.js",
         "default": "./dist/motionz.umd.js"
      }
   },
   "scripts": {
      "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
      "build": "npm run build:types && vite build",
      "watch": "tsc -w -p tsconfig.json",
      "test": "vitest run",
      "publish:npm": "npm publish",
      "publish:github": "npm publish --registry=https://npm.pkg.github.com"
   },
   "keywords": [
      "motion",
      "animation",
      "intersectionobserver",
      "typescript"
   ],
   "author": "fajriyan",
   "license": "MIT",
   "type": "module",
   "devDependencies": {
      "@types/node": "^26.1.0",
      "typescript": "^6.0.3",
      "vite": "^8.1.3",
      "vitest": "^4.1.9"
   }
}
